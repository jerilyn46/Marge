<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud backup and device-to-device transfer must not include player coins,
     cosmetics wallet, or the startup log. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
        <exclude domain="file" path="marge_startup.log"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
        <exclude domain="file" path="marge_startup.log"/>
    </device-transfer>
</data-extraction-rules>
